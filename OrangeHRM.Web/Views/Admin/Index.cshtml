@{
    ViewBag.Title = "Admin Configuration";
}

<h2>Admin Configuration</h2>

<div class="row">
    <div class="col-md-4">
        <div class="card p-3">
            <h4><i class="fas fa-briefcase"></i> Job Titles</h4>
            <ul class="list-group list-group-flush">
                @foreach (var job in ViewBag.JobTitles)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @job.Title
                        <span class="badge badge-primary badge-pill">Active</span>
                    </li>
                }
            </ul>
            <button class="btn btn-sm btn-outline-primary mt-3">Add Job Title</button>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card p-3">
            <h4><i class="fas fa-sitemap"></i> Subunits</h4>
            <ul class="list-group list-group-flush">
                @foreach (var unit in ViewBag.Subunits)
                {
                    <li class="list-group-item">@unit.Name</li>
                }
            </ul>
            <button class="btn btn-sm btn-outline-primary mt-3">Add Subunit</button>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3">
            <h4><i class="fas fa-map-marker-alt"></i> Locations</h4>
            <ul class="list-group list-group-flush">
                @foreach (var loc in ViewBag.Locations)
                {
                    <li class="list-group-item">
                        <strong>@loc.Name</strong><br/>
                        <small>@loc.City, @loc.CountryCode</small>
                    </li>
                }
            </ul>
            <button class="btn btn-sm btn-outline-primary mt-3">Add Location</button>
        </div>
    </div>
</div>
