@model OrangeHRM.Entities.PerformanceReview

@{
    ViewBag.Title = "Create Performance Review";
}

<h2>Create Performance Review</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="card p-4">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.EmployeeNumber, "Employee")
                    @Html.DropDownList("EmployeeNumber", null, "Select Employee", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.WorkPeriodStart, "Work Period Start")
                    @Html.EditorFor(m => m.WorkPeriodStart, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.WorkPeriodEnd, "Work Period End")
                    @Html.EditorFor(m => m.WorkPeriodEnd, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.DueDate, "Due Date")
                    @Html.EditorFor(m => m.DueDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Create Review</button>
            @Html.ActionLink("Cancel", "Index", "Performance", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
}
