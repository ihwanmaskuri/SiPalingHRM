@model IEnumerable<OrangeHRM.Entities.Employee>

@{
    ViewBag.Title = "Employee List";
}

<h2>Employee List</h2>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Job Title</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.EmployeeNumber</td>
                <td>@employee.FirstName @employee.LastName</td>
                <td>@employee.WorkEmail</td>
                <td>@employee.JobTitle?.Title</td>
                <td>
                    @Html.ActionLink("Details", "Details", new { id = employee.EmployeeNumber }, new { @class = "btn btn-info" })
                    @Html.ActionLink("Edit", "Edit", new { id = employee.EmployeeNumber }, new { @class = "btn btn-warning" })
                </td>
            </tr>
        }
    </tbody>
</table>

@Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })
