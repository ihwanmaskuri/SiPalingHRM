@{
    ViewBag.Title = "Punch In";
}

<h2>Punch In</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="form-group">
        @Html.Label("Employee Number")
        @Html.TextBox("empNumber", null, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.Label("Note")
        @Html.TextArea("note", null, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">Punch In</button>
}
