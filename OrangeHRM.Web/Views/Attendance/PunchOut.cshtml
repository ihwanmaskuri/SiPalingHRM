@{
    ViewBag.Title = "Punch Out";
}

<h2>Punch Out</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card p-4">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                
                <div class="form-group">
                    @Html.Label("Employee Number")
                    @Html.TextBox("empNumber", null, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    @Html.Label("Note")
                    @Html.TextArea("note", null, new { @class = "form-control", placeholder = "What did you do today?" })
                </div>

                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Current UTC Time: @DateTime.UtcNow.ToString("HH:mm:ss")
                </div>

                <button type="submit" class="btn btn-danger btn-block">
                    <i class="fas fa-sign-out-alt"></i> Punch Out Now
                </button>
            }
        </div>
    </div>
</div>
