@model OrangeHRM.Entities.JobVacancy

@{
    ViewBag.Title = "Create Job Vacancy";
}

<h2>Create Job Vacancy</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="card p-4">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.Name, "Vacancy Name")
                    @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.JobTitleId, "Job Title")
                    @Html.DropDownListFor(m => m.JobTitleId, new SelectList(ViewBag.JobTitles, "Id", "Title"), "Select Job Title", new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.NumberOfPositions, "Number of Positions")
                    @Html.EditorFor(m => m.NumberOfPositions, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.DefinedTime, "Defined Time")
                    @Html.EditorFor(m => m.DefinedTime, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                </div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Description, "Description")
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 5 })
        </div>

        <div class="form-check mb-3">
            @Html.CheckBoxFor(m => m.Status, new { @class = "form-check-input" })
            @Html.LabelFor(m => m.Status, "Active", new { @class = "form-check-label" })
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Create Vacancy</button>
            @Html.ActionLink("Cancel", "Index", "Recruitment", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
}
